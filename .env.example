# Active Directory Web Server Configuration

# Server Configuration
PORT=8080
ENVIRONMENT=development

# Timeout settings (in seconds)
READ_TIMEOUT=60
WRITE_TIMEOUT=60
IDLE_TIMEOUT=60

# Active Directory Configuration
# Required: Server and Base DN for connection
AD_SERVER=your-ad-server.example.com
AD_PORT=389
AD_BASE_DN=dc=example,dc=com

# Security Configuration
# Set AD_USE_SSL=true for LDAPS (port 636)
# Set AD_SKIP_TLS=true to skip TLS verification (not recommended for production)
AD_USE_SSL=false
AD_SKIP_TLS=false

# Optional: Path to CA certificate for LDAPS
# AD_CA_CERT_PATH=/path/to/ca-cert.pem

# Search Configuration
AD_USER_FILTER=(objectClass=user)
AD_GROUP_FILTER=(objectClass=group)
AD_SEARCH_FILTER=(objectClass=*)

# Maximum entries any single LDAP search may return, applied as the LDAP size limit.
AD_MAX_SEARCH_RESULTS=200

# Optional: Restrict searches to a specific OU (falls back to AD_BASE_DN if empty)
# AD_SEARCH_BASE_DN=OU=Corporate,dc=example,dc=com

# Optional: Semicolon-separated list of DN path fragments (OUs, CN containers) to exclude from all search results
# AD_EXCLUDED_OBJECTS=CN=Builtin,dc=example,dc=com;OU=Disabled Users,dc=example,dc=com

# Optional: Semicolon-separated list of group CNs or DNs to exclude from group results
# AD_EXCLUDED_GROUPS=Domain Admins;Schema Admins;Enterprise Admins

# Optional: Semicolon-separated group CNs or DNs allowed to use /api/v1/search.
# If unset, every authenticated user may search. Nested group membership is resolved.
# AD_SEARCH_ALLOWED_GROUPS=Helpdesk;CN=Directory Admins,OU=Groups,DC=example,DC=com

# TLS/HTTPS Configuration for the web server
# Set TLS_ENABLED=false to run HTTP instead of HTTPS
TLS_ENABLED=true
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key

# Logging
# LOG_LEVEL: debug, info, warn, error
LOG_LEVEL=info
# LOG_FORMAT: json or text (default: json)
LOG_FORMAT=json
